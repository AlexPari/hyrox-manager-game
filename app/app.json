{
  "expo": {
    "name": "Hyrox Manager",
    "slug": "hyrox-manager",
    "owner": "alexparis-team",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "scheme": "hyroxmanager",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1217",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Hyrox Manager",
      "shortName": "Hyrox",
      "themeColor": "#0F1217",
      "backgroundColor": "#0F1217"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/hyrox-manager-game/app"
    }
  }
}
